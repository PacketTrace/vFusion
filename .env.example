# Signs session cookies. Leave blank — the backend generates one on first
# boot and persists it to the vfusion_secrets volume, the same way it does
# the encryption key below. Setting it here is still supported; setting it
# to a placeholder is not, because this file is public and a published
# signing key means anyone can forge a session cookie.
SECRET_KEY=

# Encryption key for stored API keys / signing secrets. Leave blank —
# the backend auto-generates one on first boot and persists it to the
# vfusion_secrets docker volume. Set this explicitly only if you're
# managing the key out-of-band (e.g. 1Password CLI, AWS Secrets
# Manager, etc.). Format: output of Fernet.generate_key().
FERNET_KEY=

# Defaults assume the stack and your browser run on the SAME machine.
# If you run vFusion on a server/homelab box and open the dashboard from
# another device, change "localhost" below to the host's LAN IP or
# hostname (same value for both) — otherwise the dashboard can't reach
# the API. e.g. http://192.168.1.50:15173 / http://192.168.1.50:18080
CORS_ORIGINS=http://localhost:15173
VITE_API_BASE=http://localhost:18080

# Optional: comma-separated hostnames the Vite dev server will accept
# Host headers from. Leave blank (default) to allow any host — the
# dashboard isn't supposed to face the public internet anyway (the
# admin password is the real access control). Set explicitly only if
# you want Vite's DNS-rebinding protection on top of your reverse-proxy
# auth. Example:
#   VITE_ALLOWED_HOSTS=dash.example.com,homelab.local
VITE_ALLOWED_HOSTS=

# Optional. Only needed for production deploys that accept webhooks from
# Verkada's cloud via Cloudflare Tunnel. Get from Cloudflare Zero Trust
# dashboard → Networks → Tunnels → create tunnel → copy token.
# See README "Production deploy with Cloudflare Tunnel".
CF_TUNNEL_TOKEN=

# Optional. The public URL the Webhook Explorer banner displays — this
# is what Verkada's cloud needs to reach, so it MUST be publicly
# resolvable. Leave blank on first boot. In quick-tunnel mode the URL
# is auto-discovered. In lab (named-tunnel) mode, set this to your
# tunnel hostname e.g. https://hooks.yourdomain.com — but only AFTER
# you've created the tunnel in Cloudflare and confirmed the hostname
# resolves. NOT a LAN IP. Setting this prematurely just gives the
# dashboard a URL that doesn't actually work yet.
PUBLIC_WEBHOOK_BASE=

# ---------------------------------------------------------------------
# Virtual camera (RTSP -> Verkada Command Connector). Compose profile:
# `docker compose --profile rtsp up -d`
# ---------------------------------------------------------------------
# The port the Command Connector dials, and the host port the RTSP
# server binds. 8554 is the RTSP default and is often already held by
# something else on the same host -- another MediaMTX, an NVR bridge.
# Moving it here moves the URL vFusion hands out to match.
RTSP_PUBLIC_PORT=8554
# The port an ONVIF client (Verkada's Command Connector, Add Cameras ->
# IP) is told to reach. Published as a second mapping onto the backend,
# so it must match ONVIF_PUBLIC_PORT above in the app.
ONVIF_PUBLIC_PORT=8090

# ---------------------------------------------------------------------
# Explorer → Audit log
# ---------------------------------------------------------------------
# Where an audit-log IP address is. "ip-api" (default) sends public
# addresses to ip-api.com in batches, only when the page asks, and
# caches for 30 days. Private addresses are never sent. "off" disables.
GEOIP_PROVIDER=ip-api

# Workbench → Live cameras: how many cameras can be transcoded for the
# browser at once. Each is one ffmpeg; three is right for a small box.
LIVE_MAX_SESSIONS=3

# ---------------------------------------------------------------------
# Updates
# ---------------------------------------------------------------------
# Whether to check GitHub for a newer release, and which line to follow.
#
#   beta    (default) any published release, including pre-releases.
#           Right if you are running the beta branch, which is where the
#           work happens.
#   stable  only releases not marked pre-release.
#   off     no outbound request at all.
#
# The check is an unauthenticated GET to api.github.com at most once
# every six hours. It sends no version, no org id and nothing else about
# this install; it only reads. vFusion never updates itself either way —
# a newer release shows up as a badge in the header with the command to
# run, and ./update.sh runs it.
UPDATE_CHANNEL=beta

# Which published image tag docker-compose.release.yml runs. Ignored by
# the source-building docker-compose.yml. Pin it (e.g. 1.1.0) on
# anything you care about; "latest" follows the newest release, which is
# fine until a morning you did not plan to upgrade.
VFUSION_TAG=latest

# Where the dashboard's JavaScript sends its API calls, for the
# published image only. Empty (default) means same origin: the nginx
# serving the dashboard proxies to the backend, so there is no CORS to
# configure and no second port to open. Set it only when the backend
# genuinely lives elsewhere, and add the dashboard's URL to
# CORS_ORIGINS if you do.
VFUSION_API_BASE=
