.env
.env.local
# Personal deploy template — keeps an operator's 1Password / secrets-
# manager vault paths out of the public repo. If you use deploy.sh,
# keep your own .env.tpl on the host (untracked).
.env.tpl
__pycache__/
*.pyc
*.pyo
.venv/
venv/
node_modules/
dist/
*.tsbuildinfo
.DS_Store
.vscode/
.idea/
*.log
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Internal agent/dev handoff notes — never publish
CONTINUE.md

# Broker TLS material — generated per-deployment by mqtt/gen-certs.sh
mqtt/certs/
mqtt/passwd

# Generated by vFusion when the virtual camera is turned on: it carries
# the RTSP credentials handed to the Command Connector.
/rtsp/*
!/rtsp/.gitkeep
