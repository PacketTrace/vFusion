.env
.env.local
# Personal deploy template — keeps an operator's 1Password / secrets-
# manager vault paths out of the public repo. If you use deploy.sh,
# keep your own .env.tpl on the host (untracked).
.env.tpl
__pycache__/
*.pyc
*.pyo
.venv/
venv/
node_modules/
dist/
*.tsbuildinfo
.DS_Store
.vscode/
.idea/
*.log
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Internal agent/dev handoff notes — never publish
CONTINUE.md

# Broker TLS material — generated per-deployment by mqtt/gen-certs.sh
mqtt/certs/
mqtt/passwd

# Generated by vFusion when the virtual camera is turned on: it carries
# the RTSP credentials handed to the Command Connector.
/rtsp/*
!/rtsp/.gitkeep

# Internal working notes. This repo is public; the handoff records state,
# decisions and gotchas that are not for publication.
HANDOFF.md

# An Expo scaffold that appeared in the repo root, untracked and 448 MB
# of it node_modules. Ignored rather than committed because nothing has
# decided whether a mobile app belongs in this repo at all -- and until
# something does, one `git add -A` would publish the lot. Delete these
# two lines (and `git add -f`) if it is meant to live here.
/mobile/
